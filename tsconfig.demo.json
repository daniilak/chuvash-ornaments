{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "paths": {
      "@daniilak/chuvash-ornaments": [
        "./src/index.ts"
      ],
      "@daniilak/chuvash-ornaments/react": [
        "./src/react.tsx"
      ]
    }
  },
  "include": [
    "demo"
  ]
}
