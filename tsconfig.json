{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "declaration": true, "outDir": "dist", "rootDir": "src",
    "jsx": "react-jsx", "skipLibCheck": true, "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM"], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src"]
}
