iilak/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"daniilak","id":4376704,"node_id":"MDQ6VXNlcjQzNzY3MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/4376704?v=4","gravatar_id":"","url":"https://api.github.com/users/daniilak","html_url":"https://github.com/daniilak","followers_url":"https://api.github.com/users/daniilak/followers","following_url":"https://api.github.com/users/daniilak/following{/other_user}","gists_url":"https://api.github.com/users/daniilak/gists{/gist_id}","starred_url":"https://api.github.com/users/daniilak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daniilak/subscriptions","organizations_url":"https://api.github.com/users/daniilak/orgs","repos_url":"https://api.github.com/users/daniilak/repos","events_url":"https://api.github.com/users/daniilak/events{/privacy}","received_events_url":"https://api.github.com/users/daniilak/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8edc45e8079c3a1adef68eb75bd486824bd0f21d","url":"https://api.github.com/repos/daniilak/chuvash-patterns/commits/8edc45e8079c3a1adef68eb75bd486824bd0f21d","html_url":"https://github.com/daniilak/chuvash-patterns/commit/8edc45e8079c3a1adef68eb75bd486824bd0f21d"}],"stats":{"total":52,"additions":52,"deletions":0},"files":[{"sha":"dc7f9fb0290269fb97f2e5d7c2054b9d10b15bf8","filename":"README.md","status":"added","additions":52,"deletions":0,"changes":52,"blob_url":"https://github.com/daniilak/chuvash-patterns/blob/72de7df08b1a19ca68781bceec69527d3bf5868a/README.md","raw_url":"https://github.com/daniilak/chuvash-patterns/raw/72de7df08b1a19ca68781bceec69527d3bf5868a/README.md","contents_url":"https://api.github.com/repos/daniilak/chuvash-patterns/contents/README.md?ref=72de7df08b1a19ca68781bceec69527d3bf5868a","patch":"@@ -0,0 +1,52 @@\n+# Chuvash patterns / Чувашские узоры\n+\n+Координаты цифровых чувашских орнаментов из [редактора](https://daniilak.ru/pattern_editor).\n+\n+**Лицензия: [CC0 1.0](https://creativecommons.org/publicdomain/zero/1.0/)** — публичное достояние.\n+Можно копировать, менять и использовать как угодно, в том числе коммерчески, без разрешения и без указания авторства.\n+\n+Мотивы основаны на традиционных чувашских орнаментах (в т.ч. по старым источникам).\n+Часть узоров собрана из других; юридически насчёт отдельных кусков автор может ошибаться, но намерение такое: это общее наследие.\n+\n+Данные предоставляются «как есть», без гарантий.\n+\n+## Что внутри\n+\n+| Файл | Описание |\n+|------|----------|\n+| `patterns.json` | вся библиотека одним файлом |\n+| `index.json` | краткий каталог |\n+| `patterns/*.json` | каждый узор отдельно |\n+| `patterns.py` | то же для Python |\n+\n+Сейчас в наборе **31** узоров.\n+\n+## Формат\n+\n+Ось Y направлена вверх (как в математике).\n+\n+Сегмент (отрезок):\n+\n+```json\n+[[x1, y1], [x2, y2]]\n+```\n+\n+Заливка (многоугольник):\n+\n+```json\n+[[x, y], [x, y], ...]\n+```\n+\n+Пример:\n+\n+```python\n+from patterns import PATTERNS\n+\n+heart = PATTERNS[\"serdtse\"]\n+print(heart[\"name\"], len(heart[\"segments\"]))\n+```\n+\n+## Связанное\n+\n+- Редактор: https://daniilak.ru/pattern_editor\n+- Игра: https://daniilak.ru/pattern_merge"}]}