{
  "name": "@daniilak/chuvash-ornaments",
  "version": "0.1.0",
  "description": "Original Chuvash geometric motifs and deterministic SVG compositions. Dependency-free core, optional React.",
  "type": "module",
  "license": "MIT AND CC0-1.0",
  "author": "daniilak",
  "keywords": [
    "chuvash",
    "ornaments",
    "svg",
    "patterns",
    "generative",
    "react"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./data": "./data/patterns.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "vite demo --host 127.0.0.1",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run demo:build && npm run check:demo && npm run check:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "check:demo": "node --test tests/demo-ui.check.mjs",
    "examples:render": "npm run build && node scripts/render-compositions.mjs && node scripts/render-more-ornaments.mjs && node scripts/render-art-review.mjs && node scripts/render-backgrounds.mjs && node scripts/render-reference-studies.mjs && node scripts/render-aesthetic-review.mjs && node scripts/render-elite-studies.mjs && node scripts/render-atelier-studies.mjs && node scripts/render-brocade-studies.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12",
    "jsdom": "^26.1.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniilak/chuvash-ornaments.git"
  },
  "homepage": "https://daniilak.github.io/chuvash-ornaments/",
  "bugs": {
    "url": "https://github.com/daniilak/chuvash-ornaments/issues"
  }
}
